{
  "name": "@personnel/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:step1": "vite --mode step1",
    "dev:step2": "vite --mode step2",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "depcruise": "depcruise --config .dependency-cruiser.cjs src",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@personnel/domain": "*",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-virtual": "^3.14.4",
    "exceljs": "^4.4.0",
    "fflate": "^0.8.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "dependency-cruiser": "^17.4.3",
    "https-proxy-agent": "^9.0.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}
