# このファイルを .env.local にコピーして値を設定してください。
# .env.local は git 管理外です（.gitignore で除外）。

# ── アプリモード / 認証モード ─────────────────────────────────────────────────
#
# STEP1 と STEP2 は画面動線が根本的に異なる別シェル。2変数で制御する。
#
#  VITE_APP_MODE  | VITE_AUTH_MODE | 用途
#  ---------------|----------------|----------------------------------------------
#  step1          | none           | STEP1 本番。バックエンドなし・認証なし（デフォルト）
#  step2          | stub           | STEP2 DEV。Hono + SQLite + X-User-Id スタブ認証
#  step2          | sso            | STEP2 本番。Aurora + SAML SSO（スタブ認証は無効）
#
# STEP2 DEV の場合は npm run dev:server も同時に起動してください。
#
VITE_APP_MODE=step2
VITE_AUTH_MODE=stub

# ── AI API 設定 ───────────────────────────────────────────────────────────────
# VITE_AI_BASE_URL を省略するとモックモードで動作します。

# ── 推奨: apps/server の AI プロキシ経由（STEP1/STEP2 共通） ────────────────
#
# 実際の LLM の秘密鍵はブラウザに一切渡さず、apps/server だけが保持する構成。
# STEP1（バックエンドなし運用）でも AI チャットだけはこのプロキシを使う。
# サーバー側の設定は apps/server/.env.example の「AI プロキシ」セクションを参照。
#
# 事前準備: apps/server の起動が必要（STEP1 モードでも AI チャットを使うなら必須）。
#          ルートで npm run dev:step1:full（または dev:step2:full）を使うと
#          apps/server と apps/web を同時に起動できる。個別に起動するなら npm run dev:server。
#
# この値は開発用（apps/server を直接ポート指定で叩く）。
# 本番用の値（同一オリジン経由の相対パス）は apps/web/.env.production を参照。
VITE_AI_BASE_URL=http://localhost:3000/api/ai/{model}

# サーバー側の AI_PROXY_SHARED_SECRET と同じ値を設定する（実際の LLM キーではない）。
# 生成例: openssl rand -hex 24
# 開発中に使った値を本番にそのまま使い回さず、デプロイ前に新しい値へ入れ替えること。
VITE_AI_API_KEY=change-me-to-a-random-value

# API キーの送信方式。省略時は bearer → Authorization: Bearer <key>
# VITE_AI_API_KEY_SCHEME=api-key

# true にするとリクエストボディから "model" フィールドを除外する（一部のカスタム LLM で必要）。
# VITE_AI_OMIT_MODEL=true

# アプリ内のモデル選択UIに表示するモデルをカンマ区切りで指定する。
VITE_AI_MODELS=gpt-4o,gpt-4o-mini

# 旧方式（Vite/Nginx の同一オリジンリバースプロキシで LLM の秘密鍵をブラウザに持たせる構成）は
# 廃止済み（vite.config.ts から該当コードを削除済み）。上記の apps/server 経由の方式のみ使用する。
