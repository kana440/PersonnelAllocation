# DEPRECATED: the /llm-api/ approach below still requires baking the real LLM key into
# VITE_AI_API_KEY (visible in the browser bundle) unless nginx is built with
# ngx_http_auth_request_module. It is superseded by apps/server's /api/ai proxy, which keeps
# the real key server-side and needs no special nginx module. See apps/server/.env.example
# and apps/web/.env.local.example. Kept here only for reference / old deployments.
server {
    listen 80;
    server_name your-app.example.com;

    # Serve the Vite build output
    root /var/www/dist;
    index index.html;

    # SPA fallback — all unmatched paths return index.html
    location / {
        try_files $uri /index.html;
    }

    # Recommended: proxy /api/ → the Hono backend (apps/server), which itself proxies
    # AI requests to the LLM vendor while holding the real key server-side.
    location /api/ {
        proxy_pass         http://127.0.0.1:3000/api/;
        proxy_http_version 1.1;
        proxy_set_header   Host              $proxy_host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    # Legacy: Proxy /llm-api/* → LLM server directly (server-to-server, no CORS restriction)
    location /llm-api/ {
        proxy_pass         https://your-llm.internal/;
        proxy_http_version 1.1;
        proxy_set_header   Host              $proxy_host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;

        # Remove the Authorization header coming from the browser (if any)
        # and replace it with the server-side API key.
        # Requires: nginx compiled with ngx_http_auth_request_module, or use
        # the simpler approach of setting it in VITE_AI_API_KEY and letting the
        # browser send it (acceptable if traffic is internal / TLS-terminated here).
        # proxy_set_header Authorization "Bearer YOUR_API_KEY_HERE";

        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }
}
