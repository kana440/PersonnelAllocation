# ── DB 接続 ───────────────────────────────────────────────────────────────────
#
# 未設定 → PGlite（ローカル開発、サーバー不要）
# 設定済み → Aurora / PostgreSQL
#
# DATABASE_URL=postgresql://user:password@aurora-cluster.cluster-xxxx.ap-northeast-1.rds.amazonaws.com:5432/personnel

# PGlite データディレクトリ（デフォルト: data/pglite）
# DB_PATH=data/pglite

# ── Aurora 本番設定 ────────────────────────────────────────────────────────────
# Aurora への接続は DATABASE_URL だけで動作する（SSL は NODE_ENV=production 時に自動有効）
# NODE_ENV=production

# スタートアップ時の自動マイグレーションを無効化する場合（デプロイスクリプト側で実行）
# AUTO_MIGRATE=false

# 接続プールサイズ（デフォルト: 10）
# DB_POOL_MAX=10

# ── サーバー設定 ──────────────────────────────────────────────────────────────
# PORT=3000

# ── AI プロキシ（STEP1/STEP2 共通） ──────────────────────────────────────────
#
# apps/web の AIチャット機能が使う LLM の秘密鍵はここにだけ置く（クライアントには渡さない）。
# 未設定でも起動できるが、その場合 /api/ai は 503 を返す（AIチャットはモックモードで動作）。
#
# AI_LLM_BASE_URL=https://your-llm.internal/v1/{model}
# AI_LLM_API_KEY=your-real-llm-api-key
# AI_LLM_API_KEY_SCHEME=bearer   # または api-key

# 社内プロキシ経由でないと LLM ベンダーに到達できない環境向け（未設定なら直接アクセス）。
# AI_LLM_HTTP_PROXY=http://proxy.corporate:8080

# STEP1 には認証機構が無いため、この共有シークレットで最低限のアクセス制御を行う。
# 本番で AI_LLM_BASE_URL を設定する場合は必須（未設定だと起動時にエラーで止まる）。
# クライアント側の VITE_AI_API_KEY に同じ値を設定すること（実際のLLMキーではない）。
# 生成例: openssl rand -hex 24
# 開発中に使った値を本番にそのまま使い回さず、デプロイ前に新しい値へ入れ替えること。
# AI_PROXY_SHARED_SECRET=change-me-to-a-random-value
