# ── AI API settings ──────────────────────────────────────────────────────────
# Omit VITE_AI_BASE_URL to run in mock mode.

# ── Proxy setup (recommended for production) ──────────────────────────────────
#
# Browser fetch cannot set a proxy explicitly and CORS blocks cross-origin LLM
# requests.  Use a reverse proxy on the same origin instead:
#
#   Dev  : Vite dev server proxies /llm-api/* → LLM_PROXY_TARGET  (this file)
#   Prod : Nginx proxies /llm-api/* → LLM server  (see nginx.conf.example)
#
# Step 1 — set the real LLM server here (NOT exposed to browser):
# LLM_PROXY_TARGET=https://your-llm.internal
#
# Step 2 — point VITE_AI_BASE_URL at the local proxy path:
# VITE_AI_BASE_URL=/llm-api/v1/{model}
#
# If CORS is not an issue (e.g. LLM server allows your origin), you can skip
# the proxy and point VITE_AI_BASE_URL directly at the LLM server instead.

# LLM_PROXY_TARGET=https://your-llm.internal   # server-side only, no VITE_ prefix

# Base URL template — use {model} where the model name should appear.
VITE_AI_BASE_URL=/llm-api/v1/{model}

# Bearer token (sent as: Authorization: Bearer <key>)
VITE_AI_API_KEY=your-api-key-here

# Comma-separated list of models shown in the in-app selector.
VITE_AI_MODELS=gpt-4o,gpt-4o-mini
