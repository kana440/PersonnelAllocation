# ── AI API 設定 ───────────────────────────────────────────────────────────────
# VITE_AI_BASE_URL を省略するとモックモードで動作します。

# ── プロキシ設定（本番環境で推奨） ────────────────────────────────────────────
#
# ブラウザの fetch はプロキシを明示的に指定できず、クロスオリジンの LLM リクエストは
# CORS でブロックされます。同一オリジン上にリバースプロキシを立ててください。
#
#   開発時 : Vite 開発サーバーが /llm-api/* → LLM_PROXY_TARGET へ転送（このファイル）
#   本番時 : Nginx が /llm-api/* → LLM サーバーへ転送（nginx.conf.example 参照）
#
# 手順1 — 実際の LLM サーバーを指定（ブラウザには公開されない）:
# LLM_PROXY_TARGET=https://your-llm.internal
#
# 手順2 — VITE_AI_BASE_URL をローカルプロキシのパスに向ける:
# VITE_AI_BASE_URL=/llm-api/v1/{model}
#
# CORS が問題にならない場合（LLM サーバーがオリジンを許可しているなど）は
# プロキシを使わず VITE_AI_BASE_URL を LLM サーバーに直接指定しても構いません。

# LLM_PROXY_TARGET=https://your-llm.internal   # サーバーサイド専用（VITE_ プレフィックス不要）
# LLM_HTTP_PROXY=http://proxy.corporate:8080    # 社内 HTTP プロキシ（開発時のみ、https-proxy-agent 経由）

# ベース URL テンプレート — モデル名を埋め込む位置に {model} を使用する。
VITE_AI_BASE_URL=/llm-api/v1/{model}

# API キーの値。空のままにすると認証ヘッダーを送信しない。
VITE_AI_API_KEY=your-api-key-here

# API キーの送信方式。省略時は bearer → Authorization: Bearer <key>
# カスタム LLM が api-key: <key> 形式を期待する場合は "api-key" を指定する。
# VITE_AI_API_KEY_SCHEME=api-key

# true にするとリクエストボディから "model" フィールドを除外する（一部のカスタム LLM で必要）。
# VITE_AI_OMIT_MODEL=true

# アプリ内のモデル選択UIに表示するモデルをカンマ区切りで指定する。
VITE_AI_MODELS=gpt-4o,gpt-4o-mini
