server {
    listen 80;
    server_name your-app.example.com;

    # Serve the Vite build output
    root /var/www/dist;
    index index.html;

    # SPA fallback — all unmatched paths return index.html
    location / {
        try_files $uri /index.html;
    }

    # Proxy /api/ → the Hono backend (apps/server), which itself proxies AI requests to the
    # LLM vendor while holding the real key server-side (apps/server/.env: AI_LLM_API_KEY).
    location /api/ {
        proxy_pass         http://127.0.0.1:3000/api/;
        proxy_http_version 1.1;
        proxy_set_header   Host              $proxy_host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }
}
