{
  "name": "personnel-allocation",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "dev:step1": "npm run dev:step1 --workspace=apps/web",
    "dev:step2": "npm run dev:step2 --workspace=apps/web",
    "dev:server": "npm run dev --workspace=apps/server",
    "build": "npm run build --workspace=apps/web",
    "test": "npm run test --workspace=apps/web",
    "depcruise": "npm run depcruise --workspace=apps/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "typecheck:web": "npm run typecheck --workspace=apps/web",
    "typecheck:server": "npm run typecheck --workspace=apps/server",
    "typecheck:domain": "npm run typecheck --workspace=packages/domain",
    "db:reset": "npm run db:reset --workspace=apps/server",
    "eval": "promptfoo eval -c evals/promptfoo.yaml",
    "eval:routing": "promptfoo eval evals/skills/tool_routing.yaml",
    "eval:guard": "promptfoo eval evals/skills/confirm_guard.yaml",
    "eval:injection": "promptfoo eval evals/skills/injection_resistance.yaml"
  },
  "devDependencies": {
    "promptfoo": "^0.103.7"
  }
}
