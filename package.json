{
  "name": "personnel-allocation",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "dev:step1": "npm run dev:step1 --workspace=apps/web",
    "dev:step2": "npm run dev:step2 --workspace=apps/web",
    "dev:server": "npm run dev --workspace=apps/server",
    "dev:step1:full": "concurrently -n server,web -c blue,green \"npm run dev:server\" \"npm run dev:step1\"",
    "dev:step2:full": "concurrently -n server,web -c blue,green \"npm run dev:server\" \"npm run dev:step2\"",
    "build": "npm run build --workspace=apps/web",
    "test": "npm run test --workspace=apps/web",
    "depcruise": "npm run depcruise --workspace=apps/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "typecheck:web": "npm run typecheck --workspace=apps/web",
    "typecheck:server": "npm run typecheck --workspace=apps/server",
    "typecheck:domain": "npm run typecheck --workspace=packages/domain",
    "db:reset": "npm run db:reset --workspace=apps/server",
    "export:docs": "npm run export:docs --workspace=apps/web"
  },
  "devDependencies": {
    "concurrently": "^10.0.3"
  }
}
