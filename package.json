{
  "name": "personnel-allocation",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "dev:server": "npm run dev --workspace=apps/server",
    "build": "npm run build --workspace=apps/web",
    "test": "npm run test --workspace=apps/web",
    "depcruise": "npm run depcruise --workspace=apps/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "typecheck:web": "npm run typecheck --workspace=apps/web",
    "typecheck:server": "npm run typecheck --workspace=apps/server",
    "typecheck:domain": "npm run typecheck --workspace=packages/domain"
  }
}
